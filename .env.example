# ==============================================================================
# SignBridge AI Chatbot Configuration
# ==============================================================================
# Choose your preferred AI provider below and replace the placeholder with your key.
# Copy this file to .env or .env.local:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual API keys to version control.
# ==============================================================================

# Option 1: Google Gemini (Recommended)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Option 2: OpenAI
# Get a key at: https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 3: Groq (Ultra-fast open-weight models)
# Get a key at: https://console.groq.com/
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 4: Anthropic Claude
# Get a key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Option 5: Local Ollama (100% Offline AI)
# Download from: https://ollama.com/
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
